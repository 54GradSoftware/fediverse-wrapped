{
  "name": "fediverse-wrapped",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Fediverse bot that replies to a mention with your personal year in review",
  "license": "AGPL-3.0-only",
  "author": "54 Grad Software GmbH",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/54GradSoftware/fediverse-wrapped.git"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/main.ts",
    "ace": "node --env-file-if-exists=.env ace",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "@adonisjs/ace": "^14.1.1",
    "@adonisjs/core": "^7.6.0",
    "@adonisjs/env": "^7.1.0",
    "@adonisjs/lucid": "^22.4.2",
    "@fedify/botkit": "0.5.7",
    "@fedify/botkit-sqlite": "0.5.7",
    "@fedify/fedify": "~2.3.15",
    "@fedify/sqlite": "~2.3.15",
    "@fedify/vocab": "~2.3.15",
    "@fedify/vocab-runtime": "~2.3.15",
    "@formatjs/icu-messageformat-parser": "^3.5.22",
    "@logtape/logtape": "^2.4.2",
    "@resvg/resvg-js": "^2.6.2",
    "better-sqlite3": "^13.0.3",
    "html-entities": "^2.6.0",
    "intl-messageformat": "^12.1.4",
    "luxon": "^3.7.2",
    "srvx": "^1.0.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@types/node": "^26.6.5",
    "typescript": "~7.0.2"
  }
}
