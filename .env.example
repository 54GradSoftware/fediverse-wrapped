# === UNVERÄNDERLICH nach der ersten Föderation ===
# === IMMUTABLE after the first federation ========
# Diese drei Werte stecken in JEDER Actor- und Objekt-URI, die der Bot je
# veröffentlicht. Ändern = neue Identität, alle Follower verloren, kein Umzug
# möglich. Vor dem ersten öffentlichen Deploy festlegen!
# Produktion / production: https://wrapped.fedw.eu (in Coolify gesetzt).
ORIGIN=https://wrapped.example.test
# Der Teil des Handles vor @host: @fediwrapped_de@host. Nur a-z, 0-9 und _.
# Der Anzeigename ("Fediverse Wrapped") kommt aus den Locales, nicht von hier.
# The part of the handle before @host: @fediwrapped_de@host. a-z, 0-9 and _ only.
# The display name ("Fediverse Wrapped") comes from the locales, not from here.
BOT_DE_HANDLE=fediwrapped_de
BOT_EN_HANDLE=fediwrapped_en

# === Jederzeit änderbar / changeable at any time ===

# Verzeichnis (kein Dateiname!) für app.db, botkit.db und die PNGs.
DATA_DIR=./data
PORT=8000

# Pflicht. Die Tagesliste speichert nur sha256(SALT + Actor-URI), damit die
# Tabelle keine lesbare Liste aller Nutzer:innen ist. Niemals loggen.
# Ändern setzt einmalig alle Tageslimits zurück — sonst harmlos.
#   openssl rand -hex 16
ACTOR_SALT=change-me-32-random-characters

# Standard-Zeitzone für "aktivste Stunde" usw. "tz=Europe/Vienna" in der
# Erwähnung überschreibt sie. Ohne tz= vergibt der Bot keine Uhrzeit-Typen.
BOT_DE_TIMEZONE=Europe/Berlin
BOT_EN_TIMEZONE=UTC
# Kalendertag für das Limit "ein Wrapped pro Konto und Tag" (beide Bots).
RATE_LIMIT_TZ=Europe/Berlin

# Wie viele Wrappeds gleichzeitig berechnet werden. Rasterung ist CPU-gebunden;
# mehr als 2 macht auf einer kleinen VM alles langsamer.
WORKERS=2
INBOX_CONCURRENCY=2
# OHNE DIESES LIMIT startet ein Fan-out an 3000 Follower ~3000 gleichzeitige
# POSTs: SqliteMessageQueue.listen() ist nicht seriell.
DELIVERY_CONCURRENCY=8

# Mastodon lädt gecachte Medien nach seinem eigenen Purge NEU von uns. Bei 14
# Tagen zeigt ein im Januar geboostetes Wrapped im März ein kaputtes Bild.
# Rechnung: 180 Tage x 200 Wrappeds/Tag x ~280 KB ≈ 10 GB.
IMAGE_RETENTION_DAYS=180
JOB_RETENTION_DAYS=30
LEDGER_RETENTION_DAYS=60

IMPRINT_URL=https://www.54gradsoftware.de/impressum
SOURCE_URL=https://github.com/54GradSoftware/fediverse-wrapped

LOG_LEVEL=info
# Fedify ist unterhalb von "warning" sehr gesprächig. "debug" ist aber der
# einzige Weg zu sehen, WARUM eine HTTP-Signatur abgelehnt wurde.
FEDIFY_LOG_LEVEL=warning
LOG_FORMAT=json

# Testbetrieb / testing mode (geschlossene Beta). Mit "true" antworten die Bots
# nur auf Direktnachrichten von Konten, denen sie folgen, und heißen
# "… (geschlossene Beta)". Folgen tun sie nur, wenn der Betreiber es per
# `node ace follow @user@host` anstößt (siehe README › Testbetrieb).
# With "true" the bots answer only direct messages from accounts they follow and
# are named "… (Closed Beta)". They follow only what the operator adds with
# `node ace follow @user@host` (README › Testing mode).
#TESTING_MODE=false
